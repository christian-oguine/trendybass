{
  "name": "@trendybass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/scripts/migrate.ts"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
