# Copy to .env and fill in. Never commit .env.

# Local database (docker compose). Port 5436 so Kotly (5435) can run at the same time.
POSTGRES_USER=trendybass
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=trendybass
DATABASE_URL=postgres://trendybass:change-me-local-only@127.0.0.1:5436/trendybass

# Valkey (Redis-compatible): sessions cache, rate limits, job queues. Used from M2.
REDIS_URL=redis://127.0.0.1:6381

# Public site URL (canonical URLs, sitemaps, hreflang, origin check)
NUXT_PUBLIC_SITE_URL=http://localhost:3001

# The API (apps/api). The website forwards /api/* to API_URL.
API_PORT=4001
API_URL=http://127.0.0.1:4001

# Set to 1 only behind our own reverse proxy (production).
TRUST_PROXY=0

# Local inbox for emails (docker compose): http://localhost:8026. Used from M2.
MAILPIT_URL=http://127.0.0.1:8026
